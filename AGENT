<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="王浩铭项目作品：涂料厂 ERP 上的飞书多 Agent 系统与售后知识库。">
<title>一铭 ERP Agent 系统</title>
<style>html{color-scheme:light}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<style>
/* 版式：单栏阅读，最宽 960px；首屏是一条 24 小时时间轴，之后依次是范围、架构、取舍、知识库、工作方式 */
:root{
  --paper:#f3f5f4;      /* 冷调纸白，偏一点青 */
  --ink:#16222b;        /* 深石板墨色 */
  --muted:#56656f;
  --rule:#d3dbdc;
  --panel:#e7eceb;
  --accent:#0b6b6f;     /* 漆面孔雀青 */
  --accent-soft:#cfe5e3;
  --warn:#b26b12;       /* 人工确认用琥珀色 */
  --warn-soft:#f3e3cb;
  --display:"Noto Serif SC","Source Han Serif SC","Songti SC","Microsoft YaHei","PingFang SC",sans-serif;
  --body:"Noto Sans SC","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Consolas,Menlo,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#11181d; --ink:#e4ebec; --muted:#9aa9b0; --rule:#2a363d; --panel:#18232a;
    --accent:#5fc2bf; --accent-soft:#183b3d; --warn:#e3a453; --warn-soft:#3a2b17; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --paper:#11181d; --ink:#e4ebec; --muted:#9aa9b0; --rule:#2a363d; --panel:#18232a;
  --accent:#5fc2bf; --accent-soft:#183b3d; --warn:#e3a453; --warn-soft:#3a2b17; color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.75;-webkit-font-smoothing:antialiased}
.wrap{max-width:960px;margin:0 auto;padding-inline:20px;padding-block:56px 72px;display:flex;flex-direction:column;gap:88px}
h1,h2,h3{font-family:var(--display);text-wrap:balance;margin:0;line-height:1.3}
h1{font-size:clamp(30px,5.2vw,48px);font-weight:900;letter-spacing:.01em}
h2{font-size:clamp(23px,3.4vw,30px);font-weight:900}
h3{font-size:18px;font-weight:600}
p{margin:0;max-width:66ch}
.eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
.lead{font-size:18px;color:var(--muted)}
.muted{color:var(--muted)}
.small{font-size:14px}
section{display:flex;flex-direction:column;gap:22px}
.sec-head{display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--rule);padding-top:22px}
a{color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

/* 首屏 */
.hero{display:flex;flex-direction:column;gap:26px}
.meta{display:flex;flex-wrap:wrap;gap:8px 22px;font-family:var(--mono);font-size:13px;color:var(--muted)}
.meta b{color:var(--ink);font-weight:500}
.clock{background:var(--panel);border-radius:6px;padding:22px 20px 16px;display:flex;flex-direction:column;gap:14px}
.clock-title{font-size:14px;color:var(--muted)}
.track{display:grid;grid-template-columns:88px 1fr;gap:10px;align-items:center}
.track span{font-size:14px}
.bar{position:relative;height:22px;background:var(--paper);border-radius:3px}
.bar i{position:absolute;top:0;bottom:0;border-radius:3px}
.bar .orders{left:29.17%;width:66.67%;background:var(--accent)}
.bar .clerk{left:35.42%;width:37.5%;background:var(--muted)}
.bar .gap{left:29.17%;width:6.25%;background:var(--warn)}
.bar .gap2{left:72.92%;width:22.92%;background:var(--warn)}
.axis{position:relative;height:18px;margin-left:98px;font-family:var(--mono);font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums}
.axis em{position:absolute;transform:translateX(-50%);font-style:normal}
.clock-note{font-size:14px;color:var(--muted)}
.clock-note b{color:var(--warn);font-weight:700}

/* 范围 */
.scope{display:flex;flex-wrap:wrap;gap:10px}
.chip{border:1px solid var(--rule);border-radius:999px;padding:4px 14px;font-size:15px;background:var(--paper)}
.writes{font-family:var(--mono);font-size:13px;color:var(--muted)}

/* 架构图 */
.diagram{overflow-x:auto;border:1px solid var(--rule);border-radius:6px;background:var(--panel);padding:14px}
.diagram svg{display:block;width:100%;min-width:680px;height:auto;color:var(--muted)}
.diagram .box{fill:var(--paper);stroke:var(--rule);stroke-width:1.2}
.diagram .box.key{stroke:var(--accent);stroke-width:1.8}
.diagram .box.rule{stroke-dasharray:5 4;stroke:var(--muted)}
.diagram .t{fill:var(--ink);font-family:var(--body);font-size:15px;font-weight:700}
.diagram .s{fill:var(--muted);font-family:var(--body);font-size:12px}
.diagram .lay{fill:var(--accent);font-family:var(--body);font-size:13px;font-weight:700}
.diagram .ln{stroke:var(--muted);stroke-width:1.4;fill:none}
.diagram .ln.w{stroke:var(--warn);stroke-width:1.8}
.diagram .note{fill:var(--warn);font-family:var(--body);font-size:12px;font-weight:700}
.diagram .ah{fill:var(--muted)}
.diagram .ahw{fill:var(--warn)}
.legend{display:flex;flex-wrap:wrap;gap:6px 22px;font-size:13px;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:8px}
.legend i{display:inline-block;width:22px;height:0;border-top:2px solid var(--muted)}
.legend i.w{border-color:var(--warn)}
.legend i.d{border-top:2px dashed var(--muted)}

/* 设计取舍 */
.decisions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 40px}
.dec{display:flex;flex-direction:column;gap:8px;min-width:0}
.tag{font-family:var(--mono);font-size:12px;letter-spacing:.1em;color:var(--accent)}
.dec p{font-size:15px;color:var(--muted)}
.dec p b{color:var(--ink);font-weight:500}

/* 知识库 */
.pipeline{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;border:1px solid var(--rule);border-radius:6px;overflow:hidden}
.stage{padding:18px 18px 20px;display:flex;flex-direction:column;gap:8px;min-width:0}
.stage + .stage{border-left:1px solid var(--rule)}
.stage p{font-size:15px;color:var(--muted)}
.code{font-family:var(--mono);font-size:13px;color:var(--ink);background:var(--panel);padding:1px 6px;border-radius:3px}
.quote{border-left:3px solid var(--warn);background:var(--warn-soft);padding:14px 18px;border-radius:0 6px 6px 0;font-size:15px}
.quote b{color:var(--warn)}

.evalgrid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:28px;align-items:start}
.recall{display:flex;flex-direction:column;gap:14px}
.rrow{display:grid;grid-template-columns:96px 1fr 104px;gap:12px;align-items:center;font-size:14px}
.rbar{position:relative;height:16px;background:var(--panel);border-radius:2px}
.rbar i{position:absolute;left:0;top:0;bottom:0;border-radius:2px}
.rbar .lo{width:83.72%;background:var(--muted)}
.rbar .hi{left:83.72%;width:4.65%;background:var(--muted);opacity:.4;border-radius:0 2px 2px 0}
.rbar .full{width:100%;background:var(--accent)}
.rval{font-family:var(--mono);font-size:13px;font-variant-numeric:tabular-nums;text-align:right}
.raxis{display:grid;grid-template-columns:96px 1fr 104px;gap:12px;font-family:var(--mono);font-size:11px;color:var(--muted)}
.raxis div{display:flex;justify-content:space-between}
.control{display:flex;flex-direction:column;gap:6px;border-top:1px solid var(--rule);padding-top:14px}
.control .num{font-family:var(--mono);font-size:22px;font-variant-numeric:tabular-nums}

.matrix{display:grid;grid-template-columns:5.2em repeat(2,minmax(0,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);border-radius:6px;overflow:hidden;font-size:14px}
.matrix > div{background:var(--paper);padding:12px 12px;min-width:0}
.matrix .h{background:var(--panel);font-weight:700;font-size:13px}
.matrix .pick{background:var(--accent-soft)}
.matrix .pick b{color:var(--accent)}
.matrix .cost{font-family:var(--mono);font-size:12px;color:var(--muted);display:block;margin-top:4px}

.caveat{border:1px dashed var(--rule);border-radius:6px;padding:16px 18px;font-size:14px;color:var(--muted);display:flex;flex-direction:column;gap:6px}
.caveat b{color:var(--ink)}

/* 工作方式 */
.split{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}
.split ul{margin:0;padding-left:1.1em;display:flex;flex-direction:column;gap:6px;font-size:15px;color:var(--muted)}
.split li::marker{color:var(--accent)}

footer{border-top:1px solid var(--rule);padding-top:22px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;font-size:14px;color:var(--muted)}
.mail{font-family:var(--mono);color:var(--ink);user-select:all}

@media (max-width:720px){
  .decisions,.split,.evalgrid{grid-template-columns:1fr}
  .pipeline{grid-template-columns:1fr}
  .stage + .stage{border-left:0;border-top:1px solid var(--rule)}
  .track{grid-template-columns:70px 1fr}
  .axis{margin-left:80px}
  .rrow,.raxis{grid-template-columns:72px 1fr 92px}
  .wrap{gap:68px;padding-block:36px 56px}
}
</style>
</head>
<body>


<div class="wrap">

<header class="hero">
  <div class="eyebrow">项目作品 · 王浩铭 Danny Wang</div>
  <h1>在一家涂料厂的 ERP 上，<br>搭一套能真实写账的 Agent 系统</h1>
  <p class="lead">成都一铭涂料用管家婆 ERP 管销售、采购、库存和财务。我从业务和财务岗位出发，独立完成了从需求定义、架构设计到生产上线的全过程。业务员在飞书里用一句话就能下单、改单、收款报销、导出明细，系统直接写入 ERP 的凭证、库存与应收。</p>
  <div class="meta">
    <span>公司 <b>成都一铭涂料科技有限公司</b></span>
    <span>时间 <b>2026.02 – 至今</b></span>
    <span>角色 <b>独立负责</b></span>
    <span>状态 <b>生产环境运行</b></span>
  </div>

  <figure class="clock" style="margin:0" aria-label="下单时段与文员在岗时段对比">
    <div class="clock-title">项目的起点：一天 24 小时里，单子什么时候来，谁在处理</div>
    <div class="track"><span>业务员下单</span><div class="bar"><i class="orders"></i></div></div>
    <div class="track"><span>文员在岗</span><div class="bar"><i class="gap"></i><i class="clerk"></i><i class="gap2"></i></div></div>
    <div class="axis" aria-hidden="true">
      <em style="left:0%">0:00</em><em style="left:29.17%">7:00</em><em style="left:50%">12:00</em><em style="left:72.92%">17:30</em><em style="left:95.83%">23:00</em>
    </div>
    <div class="clock-note">业务员从早上 7 点到晚上 11 点都在下单，文员只在 8:30–17:30 在岗。<b>琥珀色</b>是没人处理的时段，单子和报销在这里积压。</div>
  </figure>
</header>

<section aria-labelledby="s-scope">
  <div class="sec-head">
    <div class="eyebrow">覆盖范围</div>
    <h2 id="s-scope">系统能做什么</h2>
  </div>
  <div class="scope">
    <span class="chip">下单</span><span class="chip">改单、删单</span><span class="chip">收款</span><span class="chip">费用报销</span><span class="chip">库存查询</span><span class="chip">销售明细导出与合并</span><span class="chip">月度经营报告</span><span class="chip">售后问题问答</span>
  </div>
  <p class="writes">写入对象：销售单 · 收款单 · 报销单 → ERP 凭证、库存、应收</p>
</section>

<section aria-labelledby="s-arch">
  <div class="sec-head">
    <div class="eyebrow">架构</div>
    <h2 id="s-arch">一个总路由，两类专职能力，一条不依赖模型的保底通道</h2>
  </div>
  <p class="muted">总路由 Agent 运行完整的 agent loop，自己决定调用哪些工具、按什么顺序。比如「把三月到五月的明细导出来合在一起」，它会分别导出三个月再合并。ERP 能力被封装成 MCP 工具，员工用的业务 Agent 和总路由共用同一套。</p>
  <div class="diagram" role="img" aria-label="系统架构图：飞书入口，编排层有总路由 Agent、员工业务 Agent 和纯规则下单通道；工具层有售后 Agent 和 ERP 业务 MCP；数据层有售后工单库和管家婆 ERP。写入需经预览和飞书文字确认。">
    <svg viewBox="0 0 760 440" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="ah" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path class="ah" d="M0,0 L8,4 L0,8 z"/></marker>
        <marker id="ahw" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path class="ahw" d="M0,0 L8,4 L0,8 z"/></marker>
      </defs>
      <text class="lay" x="4" y="50">入口层</text>
      <text class="lay" x="4" y="160">编排层</text>
      <text class="lay" x="4" y="285">工具层</text>
      <text class="lay" x="4" y="398">数据层</text>

      <rect class="box" x="100" y="20" width="650" height="50" rx="5"/>
      <text class="t" x="425" y="44" text-anchor="middle">飞书</text>
      <text class="s" x="425" y="61" text-anchor="middle">业务员、文员、本人 · 自然语言</text>

      <rect class="box key" x="100" y="120" width="230" height="74" rx="5"/>
      <text class="t" x="215" y="148" text-anchor="middle">总路由 Agent</text>
      <text class="s" x="215" y="168" text-anchor="middle">OpenClaw · DeepSeek</text>
      <text class="s" x="215" y="184" text-anchor="middle">完整 agent loop</text>

      <rect class="box" x="350" y="120" width="190" height="74" rx="5"/>
      <text class="t" x="445" y="148" text-anchor="middle">员工业务 Agent</text>
      <text class="s" x="445" y="168" text-anchor="middle">与总路由共用</text>
      <text class="s" x="445" y="184" text-anchor="middle">同一套 ERP 工具</text>

      <rect class="box rule" x="560" y="120" width="190" height="74" rx="5"/>
      <text class="t" x="655" y="148" text-anchor="middle">纯规则下单通道</text>
      <text class="s" x="655" y="168" text-anchor="middle">不依赖模型</text>
      <text class="s" x="655" y="184" text-anchor="middle">只做下单与打印</text>

      <rect class="box" x="100" y="245" width="190" height="74" rx="5"/>
      <text class="t" x="195" y="273" text-anchor="middle">售后 Agent</text>
      <text class="s" x="195" y="293" text-anchor="middle">qwen-flash · agent loop</text>
      <text class="s" x="195" y="309" text-anchor="middle">混合检索 · 抽取式回答</text>

      <rect class="box key" x="320" y="245" width="300" height="74" rx="5"/>
      <text class="t" x="470" y="273" text-anchor="middle">ERP 业务 MCP</text>
      <text class="s" x="470" y="293" text-anchor="middle">查询 · 导出 · 合并 · 月报</text>
      <text class="s" x="470" y="309" text-anchor="middle">写入只生成预览</text>

      <rect class="box" x="100" y="365" width="190" height="60" rx="5"/>
      <text class="t" x="195" y="391" text-anchor="middle">售后工单库</text>
      <text class="s" x="195" y="410" text-anchor="middle">结构化工单 · 向量索引</text>

      <rect class="box" x="320" y="365" width="430" height="60" rx="5"/>
      <text class="t" x="535" y="391" text-anchor="middle">管家婆 ERP</text>
      <text class="s" x="535" y="410" text-anchor="middle">只经官方存储过程写入 · 按服务划分的最小权限账号</text>

      <path class="ln" d="M215,70 V118" marker-end="url(#ah)"/>
      <path class="ln" d="M445,70 V118" marker-end="url(#ah)"/>
      <path class="ln" d="M655,70 V118" marker-end="url(#ah)"/>
      <path class="ln" d="M195,194 V243" marker-end="url(#ah)"/>
      <path class="ln" d="M300,194 V220 H380 V243" marker-end="url(#ah)"/>
      <path class="ln" d="M445,194 V243" marker-end="url(#ah)"/>
      <path class="ln" d="M195,319 V363" marker-end="url(#ah)"/>
      <path class="ln w" d="M470,319 V363" marker-end="url(#ahw)"/>
      <text class="note" x="480" y="347">写入：预览 → 本人飞书确认</text>
      <path class="ln" d="M690,194 V363" stroke-dasharray="5 4" marker-end="url(#ah)"/>
    </svg>
  </div>
  <div class="legend">
    <span><i></i>调用</span>
    <span><i class="w"></i>写入，必须先经人工确认</span>
    <span><i class="d"></i>模型或额度不可用时的保底路径</span>
  </div>
</section>

<section aria-labelledby="s-dec">
  <div class="sec-head">
    <div class="eyebrow">设计取舍</div>
    <h2 id="s-dec">几个关键判断</h2>
    <p class="muted">这类系统难的地方不在让模型更聪明，而在判断哪些环节可以交给模型，哪些必须由规则和人工确认兜住。</p>
  </div>
  <div class="decisions">
    <div class="dec">
      <div class="tag">写入路径</div>
      <h3>所有写入只走 ERP 官方存储过程</h3>
      <p>早期版本直接写表，结果凭证和应收对不上。改成调用 ERP 自己的存储过程后，事务完整性由 ERP 保证。写入前再加两道校验：<b>协议价外的产品不能开单</b>，凭证借贷必须平衡。</p>
    </div>
    <div class="dec">
      <div class="tag">人工确认</div>
      <h3>模型可以发起写入，但不能替人确认</h3>
      <p>Agent 发起的写操作只生成预览，本人在飞书回复确认后才执行。确认由程序核对真实的飞书消息，<b>操作人身份取自平台</b>，不取自模型传来的参数。</p>
    </div>
    <div class="dec">
      <div class="tag">权限边界</div>
      <h3>能力上限由权限决定，不由 prompt 决定</h3>
      <p>总路由运行在独立的系统账户下，不持有任何 ERP 凭据，只能通过 MCP 调用开放的工具。数据库按服务划分专用账号、表级最小授权，并做过一次<b>不带同样假设的独立复核</b>，找出了第一遍漏掉的继承权限。</p>
    </div>
    <div class="dec">
      <div class="tag">订单匹配</div>
      <h3>把「客户随口说的产品」当实体链接来做</h3>
      <p>第一版写规则，规则越写越多；第二版用检索把历史协议价喂给模型，错配率下不来。第三版回到业务本身：<b>客户的协议价清单就是候选集</b>。多个候选时系统绝不自选，直接让人点；选过的叫法沉淀成客户级别名表，可以手工维护。匹配不上，人接手就行；匹配错了就是一张错单。</p>
    </div>
    <div class="dec">
      <div class="tag">经营分析</div>
      <h3>月报不用 text-to-SQL</h3>
      <p>毛利、营业净利润、经营资金这些指标按财务口径事先定好，由程序从 ERP 计算，报告带数据指纹和合计核对。<b>Agent 只负责调度、投递和解读</b>，不现场写查询。</p>
    </div>
    <div class="dec">
      <div class="tag">降级</div>
      <h3>模型停了，下单不能停</h3>
      <p>下单另留一条纯规则通道，不调用任何模型，只做下单和打印。模型服务出问题或预算熔断时，业务照常运转。模型调用按轮和按月设预算上限，<b>超限自动停，只有本人能解除</b>。</p>
    </div>
  </div>
</section>

<section aria-labelledby="s-rag">
  <div class="sec-head">
    <div class="eyebrow">售后知识库 · RAG Agent</div>
    <h2 id="s-rag">宁可不答，也不答错</h2>
    <p class="muted">涂料售后问题同一个症状常有多种原因，比如开裂可能是膜厚、可能是底漆没干透、也可能是木材含水率。知识库让业务人员描述现场问题，Agent 检索历史工单，返回能追溯到原始工单的原因、处理方案和预防建议。</p>
  </div>
  <div class="pipeline">
    <div class="stage">
      <div class="tag">数据</div>
      <h3>工单写入时就定型</h3>
      <p>一张工单是一个检索单元。客户原话和施工条件用来匹配，命中后返回整张工单，原因和适用条件不会被切散。客户原话不改写，缺的字段不补，原因确定到什么程度就写什么程度。</p>
    </div>
    <div class="stage">
      <div class="tag">检索</div>
      <h3>三路召回，RRF 融合</h3>
      <p>向量检索（<span class="code">text-embedding-v4</span>）、词法检索和精确查找，用 RRF 融合（<span class="code">k=60</span>），取前 6。这些参数在实验前就固定了，没有按测试结果调。</p>
    </div>
    <div class="stage">
      <div class="tag">生成</div>
      <h3>模型只选引用，正文贴原文</h3>
      <p>模型只决定「哪张工单的哪一栏」放进回答，文字由系统从原工单粘贴。再加引用校验、危险操作类问题的规则护栏和必答栏目。资料不够就按固定模板拒答。</p>
    </div>
  </div>
  <div class="quote">真实工单上线后的检索规则：先找同型号，再退到<b>同品类</b>的其他型号，到此为止。问的是底漆开裂，就不会拿面漆的案例来回答。两级都没有，就回答「资料中没有该产品同类问题的记录」，并列出需要补充的信息。</div>

  <div class="evalgrid">
    <div class="recall">
      <h3>评估：参考工单召回（recall@6，三轮重复运行）</h3>
      <div class="rrow"><span>单路向量</span><div class="rbar"><i class="lo"></i><i class="hi"></i></div><span class="rval">83.7%–88.4%</span></div>
      <div class="rrow"><span>混合检索</span><div class="rbar"><i class="full"></i></div><span class="rval">100%（三轮）</span></div>
      <div class="raxis" aria-hidden="true"><span></span><div><span>0</span><span>50%</span><span>100%</span></div><span></span></div>
      <div class="control">
        <span class="small muted">无资料对照组：同一套题，不给任何工单</span>
        <span class="num">36 题中 1 题答完整 · 安全题 0/6</span>
        <span class="small muted">说明回答里的内容来自检索，不是模型自带的常识。</span>
      </div>
    </div>
    <div class="recall">
      <h3>模型选型：档位 × 上下文方式</h3>
      <div class="matrix">
        <div class="h"></div><div class="h">全量上下文</div><div class="h">检索</div>
        <div class="h">旗舰模型</div>
        <div>效果最好<span class="cost">约 21.5 元 / 百次</span></div>
        <div>不如全量</div>
        <div class="h">轻量模型</div>
        <div>处理不了长资料，会把 A 工单的内容挂到 B 工单<span class="cost">约 0.2 元 / 百次</span></div>
        <div class="pick"><b>线上方案</b><br>检索把上下文缩小后，轻量模型够用</div>
      </div>
      <p class="small muted">用架构换模型档位：检索缩小了上下文，才能放心用便宜的模型。</p>
    </div>
  </div>

  <div class="caveat">
    <b>评估口径</b>
    <span>36 题分六类：单点事实、同症不同因、证据不足、安全、库外、非施工问题，其中 30 题的答案只能从资料中得到。工单为 48 张模拟工单。这套题参与了迭代中的错误归因，属于开发集，以上结果不代表在新问题上的表现。下一步是用未参与调优的问题做留出测试；真实工单已开始按模板录入。</span>
  </div>
</section>

<section aria-labelledby="s-how">
  <div class="sec-head">
    <div class="eyebrow">工作方式</div>
    <h2 id="s-how">我负责判断，AI 编程工具负责执行</h2>
  </div>
  <div class="split">
    <div class="dec">
      <h3>分工</h3>
      <ul>
        <li>需求定义：从财务、供应链、售后的实际流程出发，定义要解决什么、怎样算做对</li>
        <li>架构与取舍：选框架、划权限、定哪里用模型哪里用规则</li>
        <li>实现：用 AI 编程工具（Codex 等）写代码，我逐项审查方案和改动</li>
        <li>验收：按事先写好的回归清单和评估集验收，结果不达标不上线</li>
      </ul>
    </div>
    <div class="dec">
      <h3>上线纪律</h3>
      <ul>
        <li>生产迁移放在维护窗口，切换后旧路径失败即关闭</li>
        <li>发布前核对冻结清单，文件不一致就拒绝启动</li>
        <li>独立进程监控，异常推送飞书告警</li>
        <li>密钥只进系统凭据库，不出现在代码和对话里</li>
      </ul>
    </div>
  </div>
</section>

